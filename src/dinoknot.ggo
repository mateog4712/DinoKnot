package "DinoKnot"
version "1.0"
args "--unamed-opts=input"

purpose "Minimum free energy folding of RNA-RNA, RNA-DNA and DNA-DNA interactions"

usage "DinoKnot [options] [sequence]"

description "Read RNA and DNA sequences from cmdline; predict minimum free energy and optimum structure\n Give both sequences in 5'-3' format. Place the smaller sequence on the left."

# Options

option "s1" -
    "Specify the first sequence"
    string required

option "s2" -
    "Specify the second sequence"
    string required

option "r1" -
    "Specify the pseuodoknot-free restricted structure for sequence 1 (Will not generate other hotspots)"
    string optional

option "r2" -
    "Specify the pseuodoknot-free restricted structure for sequence 2 (Will not generate other hotspots)"
    string optional

option "t1" -
    "Do not convert DNA into RNA. This will use the Matthews 2004 parameters for DNA"
    int default="0" optional

option "t2" -
    "Do not convert DNA into RNA. This will use the Matthews 2004 parameters for DNA"
    int default="0" optional

option "pen" p
    "Specify the penalty for the interactions between the sequences"
    double optional

option "opt" n
    "Specify the number of suboptimal structures to output (default is hotspot-num*hotspot-num)"
    int optional

option "input-file" i
    "Give a path to an input file containing the sequence (and input structure if known)"
    string optional

option "output-file" o
    "Give a path to an output file which will the sequence, and its structure and energy"
    string optional

option "dir" -
    "Specify the directory for which each results will have a file"
    string optional

option "hotspot-num" k
    "Specify the max number of hotspots per sequence (default is 20)"
    int default="20" optional

option "hotspot-only" l
    "Specify the path to file to output the hotspots to"
    string optional

option "dangles" d
    "Specify the dangle model to be used (base is 2)"
    int default="2" optional

option "paramFile1" P
    "Read energy parameters from paramfile, instead of using the default parameter set."
    string optional

option "paramFile2" Q
    "Read energy parameters from paramfile, instead of using the default parameter set."
    string optional

option "basePairFile" B
    "Takes a list of indices which will pair between sequences in the format a b with a being the index in sequence a and b in sequence b"
    string optional

option "varna" v
    "Specify the location for the VARNA jar"
    string optional

option "micro" -
    "Treat the interaction as a microRNA:mRNA interaction and restricting pairing on bases 2-8 in hotspot generation"
    flag off

option "hard" -
    "Treat the input structure as a hard constraint and only use method1 (HFold) for structure determination"
    flag off

text "\nThe input sequence is read from standard input, unless it is\ngiven on the command line.\n"
